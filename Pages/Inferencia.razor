@page "/inferencia"
@using DashboardEstadisticaII.Models
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization
@inject DashboardEstadisticaII.Services.DatosService DatosService
@inject DashboardEstadisticaII.Services.EstadisticaService EstadisticaService

<PageTitle>Inferencia estadística</PageTitle>

<div class="container-fluid py-4">
    <div class="row mb-4 align-items-center">
        <div class="col-lg-8">
            <h1 class="fw-bold mb-2">Módulo analista</h1>
            <p class="text-muted mb-0">Pruebas de hipótesis, intervalos de confianza, predicción y diagnóstico de residuos para el equipo técnico y analítico.</p>
        </div>
        <div class="col-lg-4 text-lg-end">
            <label class="btn btn-primary mb-0">
                Cargar archivo CSV/XLSX
                <InputFile OnChange="OnArchivoSeleccionado" accept=".csv,.xlsx,.xls" class="d-none" />
            </label>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(DatosService.ErrorMensaje))
    {
        <div class="alert alert-warning" role="alert">@DatosService.ErrorMensaje</div>
    }

    @if (!DatosService.DatosCargados)
    {
        <div class="dashboard-card text-center py-5">
            <h5 class="mb-3">No hay datos cargados</h5>
            <p class="text-muted mb-0">Cargue un dataset válido para visualizar la inferencia estadística.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-xl-6">
                <div class="dashboard-card h-100">
                    <h4 class="h5 fw-semibold mb-3">Prueba de independencia / homogeneidad</h4>
                    <p class="text-muted">Se evalúa si la distribución de Modo de Uso difiere entre las zonas.</p>
                    @if (Tabla.Filas.Count > 0 && Tabla.Columnas.Count > 0 && ChiResultado.FrecuenciasEsperadas.GetLength(0) == Tabla.Filas.Count)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th></th>
                                        @foreach (var col in Tabla.Columnas)
                                        {
                                            <th>@col</th>
                                        }
                                        <th>Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Tabla.Filas.Count; i++)
                                    {
                                        <tr>
                                            <th>@Tabla.Filas[i]</th>
                                            @for (int j = 0; j < Tabla.Columnas.Count; j++)
                                            {
                                                <td>@ChiResultado.FrecuenciasEsperadas[i, j].ToString("0.00", CultureInfo.InvariantCulture)</td>
                                            }
                                            <td class="fw-semibold">@Tabla.MarginalesFila[i]</td>
                                        </tr>
                                    }
                                    <tr>
                                        <th>Total</th>
                                        @for (int j = 0; j < Tabla.Columnas.Count; j++)
                                        {
                                            <td class="fw-semibold">@Tabla.MarginalesColumna[j]</td>
                                        }
                                        <td class="fw-semibold">@Tabla.Total</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No hay frecuencias esperadas suficientes para mostrar.</p>
                    }
                    <div class="row g-2 mt-3">
                        <div class="col-4">
                            <div class="metric-card">
                                <div class="text-muted small">Estadístico χ²</div>
                                <div class="fs-6 fw-semibold">@ChiResultado.Estadistico.ToString("0.00", CultureInfo.InvariantCulture)</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="metric-card">
                                <div class="text-muted small">Valor crítico χ²</div>
                                <div class="fs-6 fw-semibold">@ChiResultado.ValorCritico.ToString("0.00", CultureInfo.InvariantCulture)</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="metric-card">
                                <div class="text-muted small">Grados de libertad</div>
                                <div class="fs-6 fw-semibold">@ChiResultado.GradosLibertad</div>
                            </div>
                        </div>
                    </div>
                    <p class="mt-3 mb-1 fw-semibold">Interpretación</p>
                    <p class="text-muted mb-0">@InterpretacionChi</p>
                    <p class="text-muted mb-1">
                        p-valor = @ChiResultado.PValor.ToString("0.0000", CultureInfo.InvariantCulture).
                        Si p-valor &lt; @alfaChi.ToString("0.00", CultureInfo.InvariantCulture), se rechaza H₀.
                    </p>
                    <p class="mt-3 mb-1 fw-semibold">Supuestos</p>
                    <p class="text-muted mb-0">@ChiResultado.MensajeSupuestos</p>
                </div>
            </div>

            <div class="col-xl-6">
                <div class="dashboard-card h-100">
                    <h4 class="h5 fw-semibold mb-3">Prueba t para la pendiente</h4>
                    <label class="form-label">Nivel de confianza</label>
                    <input type="range" class="form-range" min="90" max="99" step="1" @bind="nivelConfianza" @bind:event="oninput" />
                    <div class="text-muted small mb-3">@nivelConfianza% de confianza</div>
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="metric-card">
                                <div class="text-muted small">t</div>
                                <div class="fs-5 fw-semibold">@Regresion.EstadisticoT.ToString("0.000", CultureInfo.InvariantCulture)</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="metric-card">
                                <div class="text-muted small">p-valor</div>
                                <div class="fs-5 fw-semibold">@Regresion.PValorT.ToString("0.0000", CultureInfo.InvariantCulture)</div>
                            </div>
                        </div>
                    </div>
                    <p class="mt-3 mb-1 fw-semibold">Conclusión detallada</p>
                    <p class="text-muted mb-0">@InterpretacionPruebaT</p>

                    <div class="mt-3">
                        <svg viewBox="0 0 420 220" class="chart-svg">
                            <line x1="30" y1="190" x2="390" y2="190" stroke="#6c757d" stroke-width="1"></line>
                            <line x1="30" y1="20" x2="30" y2="190" stroke="#6c757d" stroke-width="1"></line>
                            @foreach (var punto in PuntosRegresion)
                            {
                                <circle cx="@punto.X" cy="@punto.Y" r="4" fill="#0d6efd"></circle>
                            }
                            <line x1="30" y1="@YInterceptoRecta" x2="390" y2="@YFinalRecta" stroke="#fd7e14" stroke-width="2"></line>
                        </svg>
                        <div class="small text-muted mt-2">
                            <div><strong>Gráfico:</strong> dispersión de precio vs. cantidad y recta de regresión estimada.</div>
                        </div>
                    </div>

                    <label class="form-label mt-3">Precio para predicción</label>
                    <input type="number" class="form-control mb-3" @bind="valorXPrediccion" @bind:event="oninput" min="0" step="10000" />

                    <p class="mt-2 mb-1 fw-semibold">Predicción con el modelo</p>
                    <p class="text-muted mb-0">ŷ = @Regresion.B0.ToString("0.00", CultureInfo.InvariantCulture) @((Regresion.B1 >= 0) ? "+" : "-") @Math.Abs(Regresion.B1).ToString("0.000", CultureInfo.InvariantCulture) × Precio</p>
                    <p class="text-muted mb-0">Intervalo de confianza de la media para Precio = @valorXPrediccion.ToString("0", CultureInfo.InvariantCulture): @ICMedia.limInf.ToString("0.00", CultureInfo.InvariantCulture) a @ICMedia.limSup.ToString("0.00", CultureInfo.InvariantCulture)</p>
                    <p class="text-muted mb-0">Intervalo de predicción individual: @IPrediccion.limInf.ToString("0.00", CultureInfo.InvariantCulture) a @IPrediccion.limSup.ToString("0.00", CultureInfo.InvariantCulture)</p>
                    <p class="text-muted mb-0">R² = @Regresion.R2.ToString("0.00", CultureInfo.InvariantCulture), lo que indica que una parte significativa de la variabilidad en cantidad se explica por el precio.</p>

                    <p class="mt-3 mb-1 fw-semibold">Intervalo de confianza para la pendiente</p>
                    <p class="text-muted mb-0">Con un @nivelConfianza% de confianza, el intervalo estimado para la pendiente es [@ICPendiente.limInf.ToString("0.000", CultureInfo.InvariantCulture), @ICPendiente.limSup.ToString("0.000", CultureInfo.InvariantCulture)].</p>
                    <p class="text-muted mb-0">Si este intervalo contiene al 0, no hay evidencia suficiente para afirmar que la pendiente sea distinta de cero.</p>
                </div>
            </div>
        </div>

        <div class="row g-4 mt-1">
            <div class="col-xl-6">
                <div class="dashboard-card h-100">
                    <h4 class="h5 fw-semibold mb-3">Intervalo de confianza del coeficiente r</h4>
                    <p class="text-muted">Estimación del rango plausible de la correlación poblacional.</p>
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="metric-card">
                                <div class="text-muted small">Coeficiente r</div>
                                <div class="fs-6 fw-semibold">@Regresion.R.ToString("0.000", CultureInfo.InvariantCulture)</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="metric-card">
                                <div class="text-muted small">Intervalo para r</div>
                                <div class="fs-6 fw-semibold">[@ICCorrelacion.limInf.ToString("0.000", CultureInfo.InvariantCulture), @ICCorrelacion.limSup.ToString("0.000", CultureInfo.InvariantCulture)]</div>
                            </div>
                        </div>
                    </div>
                    <p class="mt-3 mb-1 fw-semibold">Interpretación</p>
                    <p class="text-muted mb-0">@InterpretacionCorrelacionInferencia</p>
                </div>
            </div>

            <div class="col-xl-6">
                <div class="dashboard-card h-100">
                    <h4 class="h5 fw-semibold mb-3">Diagnóstico de residuos</h4>
                    <svg viewBox="0 0 420 260" class="chart-svg">
                        <line x1="30" y1="220" x2="390" y2="220" stroke="#6c757d" stroke-width="1"></line>
                        <line x1="30" y1="20" x2="30" y2="220" stroke="#6c757d" stroke-width="1"></line>
                        <line x1="30" y1="110" x2="390" y2="110" stroke="#adb5bd" stroke-dasharray="4 4"></line>
                        @foreach (var punto in PuntosResiduos)
                        {
                            <circle cx="@punto.X" cy="@punto.Y" r="4" fill="#198754"></circle>
                        }
                    </svg>
                    <div class="small text-muted mt-3">
                        <div><strong>Eje X:</strong> valores ajustados (estimados)</div>
                        <div><strong>Eje Y:</strong> residuos, línea gris = referencia en cero</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mt-1">
            <div class="col-12">
                <div class="dashboard-card">
                    <h4 class="h5 fw-semibold mb-3">Q-Q Plot de residuos</h4>
                    <svg viewBox="0 0 420 260" class="chart-svg">
                        <line x1="30" y1="220" x2="390" y2="220" stroke="#6c757d" stroke-width="1"></line>
                        <line x1="30" y1="20" x2="30" y2="220" stroke="#6c757d" stroke-width="1"></line>
                        <line x1="30" y1="220" x2="390" y2="20" stroke="#adb5bd" stroke-dasharray="4 4"></line>
                        @foreach (var punto in PuntosQQ)
                        {
                            <circle cx="@punto.X" cy="@punto.Y" r="4" fill="#dc3545"></circle>
                        }
                    </svg>
                    <div class="small text-muted mt-3">
                        <div><strong>Eje X:</strong> cuantiles teóricos de la normal</div>
                        <div><strong>Eje Y:</strong> cuantiles observados de los residuos</div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private int nivelConfianza = 95;
    private double valorXPrediccion = 1000000;

    protected override void OnInitialized()
    {
        DatosService.OnDatosChanged += OnDatosActualizados;
        ActualizarValorPrediccionDefecto();
    }

    private void OnDatosActualizados()
    {
        ActualizarValorPrediccionDefecto();
        StateHasChanged();
    }

    private void ActualizarValorPrediccionDefecto()
    {
        if (DatosService.Ventas.Count > 0)
        {
            var media = (double)DatosService.Ventas.Average(v => v.Precio);
            valorXPrediccion = Math.Round(media, -4); // Redondear a miles
        }
    }

    public void Dispose()
    {
        DatosService.OnDatosChanged -= OnDatosActualizados;
    }

    private async Task OnArchivoSeleccionado(InputFileChangeEventArgs e)
    {
        if (e.File is not null)
        {
            await DatosService.CargarArchivo(e.File);
        }
    }

    private readonly double alfaChi = 0.05;
    private TablaContingenciaResult Tabla => EstadisticaService.CalcularTablaContingencia(DatosService.Ventas);
    private ChiCuadradoResult ChiResultado => EstadisticaService.CalcularChiCuadrado(Tabla, alfaChi);
    private RegresionResult Regresion => EstadisticaService.CalcularRegresion(DatosService.Ventas);
    private string InterpretacionChi => EstadisticaService.InterpretarChiCuadrado(ChiResultado, alfaChi);
    private string InterpretacionCorrelacionInferencia => EstadisticaService.InterpretarCorrelacion(Regresion.R);
    private string InterpretacionPruebaT => EstadisticaService.InterpretarPruebaT(Regresion, 1 - (nivelConfianza / 100.0));

    private (double limInf, double limSup) ICCorrelacion
    {
        get
        {
            return EstadisticaService.IntervaloConfianzaCorrelacion(Regresion.R, Regresion.N, nivelConfianza);
        }
    }

    private (double limInf, double limSup) ICPendiente
    {
        get
        {
            var resultado = EstadisticaService.IntervaloConfianza(Regresion.B1, Regresion.ErrorEstandarB1, Regresion.GradosLibertad, nivelConfianza);
            return (resultado.limInf, resultado.limSup);
        }
    }

    private (double limInf, double limSup) ICMedia
    {
        get
        {
            var resultado = EstadisticaService.IntervaloConfianzaMedia(Regresion, valorXPrediccion, nivelConfianza);
            return (resultado.limInf, resultado.limSup);
        }
    }

    private (double limInf, double limSup) IPrediccion
    {
        get
        {
            var resultado = EstadisticaService.IntervaloPrediccion(Regresion, valorXPrediccion, nivelConfianza);
            return (resultado.limInf, resultado.limSup);
        }
    }

    private List<(string X, string Y)> PuntosRegresion
    {
        get
        {
            var puntos = new List<(string X, string Y)>();
            if (Regresion.ValoresX.Count == 0 || Regresion.ValoresY.Count == 0) return puntos;

            double minX = Regresion.ValoresX.Min();
            double maxX = Regresion.ValoresX.Max();
            double minY = Regresion.ValoresY.Min();
            double maxY = Regresion.ValoresY.Max();
            double spanX = Math.Max(1, maxX - minX);
            double spanY = Math.Max(1, maxY - minY);

            for (int i = 0; i < Regresion.ValoresX.Count; i++)
            {
                double x = 30 + ((Regresion.ValoresX[i] - minX) / spanX) * 360;
                double y = 190 - ((Regresion.ValoresY[i] - minY) / spanY) * 170;
                puntos.Add((x.ToString(CultureInfo.InvariantCulture), y.ToString(CultureInfo.InvariantCulture)));
            }

            return puntos;
        }
    }

    private string YInterceptoRecta
    {
        get
        {
            if (Regresion.ValoresX.Count == 0 || Regresion.ValoresY.Count == 0) return "190";
            double minX = Regresion.ValoresX.Min();
            double maxX = Regresion.ValoresX.Max();
            double minY = Regresion.ValoresY.Min();
            double maxY = Regresion.ValoresY.Max();
            double spanY = Math.Max(1e-9, maxY - minY);
            double y0 = 190 - ((Regresion.B0 + Regresion.B1 * minX - minY) / spanY) * 170;
            return Math.Round(y0, 2).ToString(CultureInfo.InvariantCulture);
        }
    }

    private string YFinalRecta
    {
        get
        {
            if (Regresion.ValoresX.Count == 0 || Regresion.ValoresY.Count == 0) return "190";
            double minX = Regresion.ValoresX.Min();
            double maxX = Regresion.ValoresX.Max();
            double minY = Regresion.ValoresY.Min();
            double maxY = Regresion.ValoresY.Max();
            double spanY = Math.Max(1e-9, maxY - minY);
            double y1 = 190 - ((Regresion.B0 + Regresion.B1 * maxX - minY) / spanY) * 170;
            return Math.Round(y1, 2).ToString(CultureInfo.InvariantCulture);
        }
    }

    private List<(string X, string Y)> PuntosResiduos
    {
        get
        {
            var puntos = new List<(string X, string Y)>();
            if (Regresion.ValoresAjustados.Count == 0 || Regresion.Residuos.Count == 0) return puntos;

            double minX = Regresion.ValoresAjustados.Min();
            double maxX = Regresion.ValoresAjustados.Max();
            double minY = Regresion.Residuos.Min();
            double maxY = Regresion.Residuos.Max();
            double spanX = Math.Max(1e-9, maxX - minX);
            double spanY = Math.Max(1e-9, maxY - minY);

            for (int i = 0; i < Regresion.ValoresAjustados.Count; i++)
            {
                double x = 30 + ((Regresion.ValoresAjustados[i] - minX) / spanX) * 360;
                double y = 220 - ((Regresion.Residuos[i] - minY) / spanY) * 200;
                puntos.Add((x.ToString(CultureInfo.InvariantCulture), y.ToString(CultureInfo.InvariantCulture)));
            }

            return puntos;
        }
    }

    private List<(string X, string Y)> PuntosQQ
    {
        get
        {
            var puntos = new List<(string X, string Y)>();
            if (Regresion.Residuos.Count == 0) return puntos;
            var qq = EstadisticaService.CalcularQQPlot(Regresion.Residuos);
            if (qq.Count == 0) return puntos;

            double minX = qq.Min(p => (double)p.X);
            double maxX = qq.Max(p => (double)p.X);
            double minY = qq.Min(p => (double)p.Y);
            double maxY = qq.Max(p => (double)p.Y);
            double spanX = Math.Max(1e-9, maxX - minX);
            double spanY = Math.Max(1e-9, maxY - minY);

            foreach (var punto in qq)
            {
                double x = 30 + (((double)punto.X - minX) / spanX) * 360;
                double y = 220 - (((double)punto.Y - minY) / spanY) * 200;
                puntos.Add((x.ToString(CultureInfo.InvariantCulture), y.ToString(CultureInfo.InvariantCulture)));
            }

            return puntos;
        }
    }
}
